g=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="101" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Informatisation des CLARDERS&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_5_1 (aef_1_5_1.osq)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-15 (Écran SIGARE)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="477" width="360" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Ouverture du programme aux admissions&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_1_1 (aef_1_1_1.osq)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="603" width="360" height="71" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Produire le programme sur le WEB et produire le tiré à part&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_1_3_5 (aef_1_1_3_5.osq)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-18 (Écran SIGARE)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="360" height="101" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Transférer le programme sur le WWW&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_1_3_8 (aef_1_1_3_8.osq)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-18 (Écran SIGARE)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="360" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — S&#x27;il y a lieu, suivi des modifications dans les programmes touchés par la création (cours partagés)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_1_1&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="981" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A14" name="A14 - Avis donné aux personnes concernées par "><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A14 — Avis donné aux personnes concernées par la création du programme&lt;/b&gt;&lt;br&gt;&lt;i&gt;Informer toute personne concernée (directions modulaires/départementales, registraire, services aux étudiants, etc.): nouveaux développements, impacts sur l&#x27;offre de cours, exigences EQE, etc.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Préparation du bilan global (état des cours)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-16." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="101" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Envoi du bilan global aux directeurs de module et département concernés (offre de cours et EQE)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Courrier interne." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="101" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Avis donné au Bureau du registraire (programme ouvert aux admissions) et à l&#x27;Information universitaire (recrutement/promotion)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="477" width="360" height="101" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Avis donné au directeur du regroupement l&#x27;invitant à réviser la version officielle du programme sur le WEB et signaler erreurs/omissions&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="360" height="116" as="geometry"/></mxCell><mxCell id="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>