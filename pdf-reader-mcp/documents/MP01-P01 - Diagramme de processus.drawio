<mxfile host="app.diagrams.net" agent="claude-code-generator" version="24.0.0"><diagram id="page-overview" name="Vue d&#x27;ensemble"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;MP01 — Gestion de la banque des programmes et des cours&lt;/b&gt;&lt;br&gt;&lt;i&gt;L&#x27;ensemble des processus et opérations liés à la gestion de la banque des programmes, de la banque cours et des CLARDERS (SIGARE et WEB institutionnel).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;spacing=8;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="780" height="70" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;P01 — Création d&#x27;un programme de grade&lt;/b&gt; (V.1, statut : en cours)&lt;br&gt;&lt;i&gt;Secteur : Décanat des études &amp;nbsp;|&amp;nbsp; Intrants : demande interne / ministérielle / externe &amp;nbsp;|&amp;nbsp; Extrant : nouveau programme de grade ouvert aux admissions.&lt;/i&gt;&lt;br&gt;Instances internes : Conseil de module/unité/comité de programme &amp;#8594; SCE &amp;#8594; CET &amp;#8594; CAD.&lt;br&gt;Instances externes : Conseil des études UQ (CE-UQ) &amp;#8594; CEP-CRÉPUQ &amp;#8594; CPU-MELS &amp;#8594; Autorisation ministérielle de financement.&lt;br&gt;Un programme de grade peut être baccalauréat, baccalauréat avec majeure, maîtrise ou doctorat; conjoint/réseau possible (protocole d&#x27;entente)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="780" height="130" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Comment naviguer&lt;/b&gt;&lt;br&gt;Double-cliquez sur une activité (A01…A14) pour ouvrir le détail de ses tâches sur une page dédiée. Chaque page de détail comporte un bouton de retour vers cette vue d&#x27;ensemble. Le déroulement est séquentiel : chaque activité et chaque tâche s&#x27;enchaîne dans l&#x27;ordre affiché (quelques boucles conditionnelles sont notées dans les commentaires des tâches concernées)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="840" y="0" width="320" height="220" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;A01&lt;/b&gt; — Proposition d&#x27;un plan de travail accompagné des étapes et de l&#x27;échéancier du projet de création" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A01"><mxGeometry x="40" y="250" width="420" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;A02&lt;/b&gt; — Rédaction du dossier de présentation de la création" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A02"><mxGeometry x="40" y="380" width="420" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;A03&lt;/b&gt; — Lecture et analyse du dossier de présentation de la création" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A03"><mxGeometry x="40" y="510" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;A04&lt;/b&gt; — Consultation officielle auprès des directeurs de regroupement de programmes et des directeurs de département" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A04"><mxGeometry x="40" y="640" width="420" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;A05&lt;/b&gt; — Dépôt du dossier pour approbation par le conseil de module, d&#x27;unité ou comité de programme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A05"><mxGeometry x="40" y="770" width="420" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A06&lt;/b&gt; — Présentation du dossier à la Sous-commission des études (SCE) aux fins de recommandation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A06"><mxGeometry x="40" y="900" width="420" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;A07&lt;/b&gt; — Présentation du dossier à la Commission des études (CET) aux fins de recommandation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A07"><mxGeometry x="40" y="1030" width="420" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;A08&lt;/b&gt; — Présentation des demandes de ressources générées par le projet au CODER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A08"><mxGeometry x="40" y="1160" width="420" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;A09&lt;/b&gt; — Présentation des descriptifs de cours nécessitant un nouveau code à la Conférence des directeurs de département (CDD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A09"><mxGeometry x="40" y="1290" width="420" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;A10&lt;/b&gt; — Assignation des CLARDERS aux nouveaux cours et aux cours modifiés" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A10"><mxGeometry x="40" y="1420" width="420" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;A11&lt;/b&gt; — Présentation du dossier au Conseil des études UQ, à la CEP-CRÉPUQ et au CPU-MELS (instances externes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A11"><mxGeometry x="40" y="1550" width="420" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;A12&lt;/b&gt; — Présentation du dossier au Conseil d&#x27;administration (CAD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A12"><mxGeometry x="520" y="250" width="420" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;A13&lt;/b&gt; — Informatisation des cours, des CLARDERS et du programme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A13"><mxGeometry x="520" y="380" width="420" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;A14&lt;/b&gt; — Avis donné aux personnes concernées par la création du programme" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1" link="data:page/id,page-A14"><mxGeometry x="520" y="510" width="420" height="90" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A01" name="A01 - Proposition d&#x27;un plan de travail accompa"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A01 — Proposition d&#x27;un plan de travail accompagné des étapes et de l&#x27;échéancier du projet de création&lt;/b&gt;&lt;br&gt;&lt;i&gt;Plan de travail élaboré par la coordonnatrice et proposé au directeur du regroupement de programmes, qui peut déléguer la responsabilité du dossier à un porteur de dossier.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Production du document Étapes et échéancier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-1 (exemple). Document demeure ouvert; nouvel échéancier produit au besoin." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Impression du document Étapes et échéancier&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="71" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Production de la table des matières du dossier de création (brouillon)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-2 Table des matières (gabarit)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="360" height="101" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Envoi de la table des matières (brouillon) au commis sénior&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="360" height="86" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Création du dossier de présentation de la création à partir de la table des matières&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Document maître, demeure dans l&#x27;ordinateur de la commis sénior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="360" height="116" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Impression de la table des matières&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="360" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Rencontre de lancement du projet avec les intervenants: explications et remise de documents&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Autres documents rassemblés (papier). Voir MP1-P1-3 guides/outils/politiques/procédures." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="360" height="116" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A02" name="A02 - Rédaction du dossier de présentation de "><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A02 — Rédaction du dossier de présentation de la création&lt;/b&gt;&lt;br&gt;&lt;i&gt;Réalisée principalement par le directeur du regroupement de programmes ou son porteur de dossier, avec support technique (commis sénior) et documentaire/stratégique (coordonnatrice).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Rédaction des textes constituant le dossier de présentation de la création&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Directeur, Regroupement de programmes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Réception des textes constituant le dossier de présentation de la création&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Saisie des textes produits par le directeur et insertion dans la partie Word du document maître&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="360" height="101" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Saisie des descriptifs de cours et insertion dans la partie File Maker du document maître (banque de cours)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-17 (exemple banque de cours file maker)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="360" height="131" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Échanges avec le directeur (support technique)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook entre autres&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Téléphone, courriel ou présentiel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="759" width="360" height="101" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Interrogation SIGARE ou autres recherches (annuaires, archives, WEB, etc.) au besoin&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_3_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="360" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Échanges avec le directeur (support documentaire, analytique et stratégique)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook entre autres&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Expertise-conseil, Intranet UQ, dossiers antérieurs, archives, statistiques MELS/CRÉPUQ. Voir MP1-P1-4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1026" width="360" height="116" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A03" name="A03 - Lecture et analyse du dossier de présent"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A03 — Lecture et analyse du dossier de présentation de la création&lt;/b&gt;&lt;br&gt;&lt;i&gt;Analyse détaillée effectuée en profondeur par la coordonnatrice: complétude, articulation, qualité/pertinence/opportunité, impacts, conformité RG2/RG3 (UQ) et Manuel de gestion (UQAC).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Impression du document maître (parties Word et File Maker) - Brouillon&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="71" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Analyse et lecture commentée manuscrite du document maître papier: annotations, révisions, stratégies de rédaction&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Échanges avec le directeur au besoin, pour éclaircissements et suggestions&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook entre autres&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="360" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Réécriture Word de certains textes au besoin lorsque les annotations manuscrites ne suffisent pas&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — S&#x27;il y a lieu, envoi des textes réécrits au commis sénior&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="699" width="360" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Faire des recherches sur les programmes au besoin, sur demande de la coordonnatrice&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_1_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="825" width="360" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Faire des recherches sur les cours au besoin, sur demande de la coordonnatrice&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_3_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="951" width="360" height="86" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Faire des recherches sur l&#x27;offre de cours au besoin, sur demande de la coordonnatrice&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_4_3&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1077" width="360" height="101" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — Faire des recherches dans les listes de programmes et de cours&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; WEB UQAC/SIGARE&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Ex: cours partagés, cours inactifs, cours préalables, statut/type/fréquence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1218" width="360" height="116" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;T10&lt;/b&gt; — Remise du document maître papier (brouillon) révisé et annoté au commis sénior (en main propre)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1374" width="360" height="86" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;T11&lt;/b&gt; — Insertion des corrections et modifications dans le document maître (Word et File maker)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word, File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="360" height="101" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;T12&lt;/b&gt; — Impression du dossier de présentation de la création&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1641" width="360" height="71" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;T13&lt;/b&gt; — Première numérisation du dossier de présentation de la création&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1752" width="360" height="71" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A04" name="A04 - Consultation officielle auprès des direc"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A04 — Consultation officielle auprès des directeurs de regroupement de programmes et des directeurs de département&lt;/b&gt;&lt;br&gt;&lt;i&gt;Permet aux directeurs concernés de prendre connaissance du projet, d&#x27;analyser les impacts et de commenter dans un délai de 7-10 jours ouvrables (annexes Word + fiche-synthèse, voir MP1-P1-7).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Envoi des annexes de consultation + dossier numérisé aux directeurs (regroupement et département) et au registraire, avec délai de réponse&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Réception des commentaires des directeurs et du registraire&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook entre autres&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Parfois par courrier interne ou en main propre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="351" width="360" height="101" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Oblitération des commentaires reçus&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Date d&#x27;impression du courriel fait foi si reçu par courriel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="360" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Vérifications d&#x27;usage: commentaires signés/datés par les directeurs respectifs&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="360" height="71" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Impression des commentaires et versement au dossier papier&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="729" width="360" height="71" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Inscription sur la fiche synthèse des secteurs ayant répondu + date, et versement au dossier papier&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="360" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Remise en main propre ou par courriel des commentaires reçus au directeur du regroupement afin qu&#x27;il y réagisse&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Rédaction de la réponse aux commentaires par le directeur du regroupement (lettre adressée au doyen)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Directeur, Regroupement de programmes&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Peut impliquer des négociations interdépartementales/interprogrammes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1107" width="360" height="131" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — Rédaction de la lettre de transmission du dossier au Décanat (lettre adressée au doyen)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Directeur, Regroupement de programmes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1278" width="360" height="101" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;T10&lt;/b&gt; — Réception des deux documents précédents (réponse aux commentaires et lettre de transmission)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Courrier interne ou en main propre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1419" width="360" height="101" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;T11&lt;/b&gt; — Oblitération des deux documents reçus&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="360" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;T12&lt;/b&gt; — Vérifications d&#x27;usage si signés/datés&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="360" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;T13&lt;/b&gt; — Versement des deux documents précédents au dossier papier de présentation de la création&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="360" height="86" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A05" name="A05 - Dépôt du dossier pour approbation par le"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A05 — Dépôt du dossier pour approbation par le conseil de module, d&#x27;unité ou comité de programme&lt;/b&gt;&lt;br&gt;&lt;i&gt;Par voie de résolution, l&#x27;instance responsable du nouveau programme approuve le projet - essentielle à la poursuite du cheminement (avec ou sans conditions/réserves).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Tenue du conseil de module, d&#x27;unité ou du comité de programme (présentation et approbation)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Directeur, Regroupement de programmes&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Le directeur préside; la coordonnatrice peut accompagner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Réception de la résolution du conseil de module&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Courrier interne, main propre." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Oblitération de la résolution&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Vérifications d&#x27;usage: signature/date, coordonnées de la réunion inscrites&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="360" height="71" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Versement de la résolution au dossier papier de présentation de la création&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="683" width="360" height="71" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Révision/vérification complète du dossier et de la résolution avant envoi au Bureau du Secrétaire général&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="794" width="360" height="101" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Deuxième numérisation du dossier (incluant les dernières pièces versées) aux fins de la SCE&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="360" height="86" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A06" name="A06 - Présentation du dossier à la Sous-commis"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A06 — Présentation du dossier à la Sous-commission des études (SCE) aux fins de recommandation&lt;/b&gt;&lt;br&gt;&lt;i&gt;Première instance interne - conditionnelle à la poursuite du cheminement du dossier dans les instances subséquentes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Inscription des points à l&#x27;ordre du jour de la SCE auprès du Bureau du Secrétaire général&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="101" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Production de l&#x27;Avis d&#x27;inscription à la SCE et synthèse du dossier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Mise en pages de l&#x27;Avis d&#x27;inscription et synthèse sur le formulaire dédié&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-8 (exemple)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="360" height="101" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Envoi du dossier complet numérisé + Avis d&#x27;inscription au Bureau du Secrétaire général, 10 jours ouvrables avant la SCE&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Tenue de la SCE aux fins de présentation et d&#x27;approbation du dossier&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Doyen/Doyenne, Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Le doyen préside; la coordonnatrice assiste, répond aux questions, prend des notes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="729" width="360" height="116" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Suivi auprès du directeur du regroupement de programmes&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Informer de la décision de la SCE; actions à prendre s&#x27;il y a lieu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="360" height="101" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — S&#x27;il y a lieu, modifications et/ou corrections aux textes et descriptifs de cours&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word, File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1026" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Extraction et impression de la résolution de la SCE et versement au dossier papier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; WEB UQAC&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1167" width="360" height="101" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — S&#x27;il y a lieu, nouvelle numérisation du dossier afin de tenir compte des modifications apportées&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Boucle possible vers T07 si modifications." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1308" width="360" height="101" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A07" name="A07 - Présentation du dossier à la Commission "><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A07 — Présentation du dossier à la Commission des études (CET) aux fins de recommandation&lt;/b&gt;&lt;br&gt;&lt;i&gt;Deuxième instance interne - conditionnelle à la poursuite du cheminement du dossier dans les instances subséquentes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Inscription des points à l&#x27;ordre du jour de la CET auprès du Bureau du Secrétaire général&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="101" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Production de l&#x27;Avis d&#x27;inscription à la CET et synthèse du dossier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Mise en pages de l&#x27;Avis d&#x27;inscription et synthèse sur le formulaire dédié&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="360" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Envoi numérisé de l&#x27;Avis d&#x27;inscription, 10 jours ouvrables avant la CET (dossier + résolution SCE)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="573" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Tenue de la CET aux fins de présentation et d&#x27;approbation du dossier&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Recteur, Doyen/Doyenne, Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Le recteur préside; la coordonnatrice et le doyen assistent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="360" height="116" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Suivi auprès du directeur du regroupement de programmes&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="360" height="71" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — S&#x27;il y a lieu, modifications et/ou corrections aux textes et descriptifs de cours&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word, File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="981" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Extraction et impression de la résolution de la CET et versement au dossier papier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; WEB UQAC&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1122" width="360" height="101" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — S&#x27;il y a lieu, nouvelle numérisation du dossier afin de tenir compte des modifications apportées&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Boucle possible vers T07." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1263" width="360" height="101" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A08" name="A08 - Présentation des demandes de ressources "><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A08 — Présentation des demandes de ressources générées par le projet au CODER&lt;/b&gt;&lt;br&gt;&lt;i&gt;Précède le CAD: comptabilise le coût (RH, physiques, financières, activités d&#x27;enseignement); pro forma et budgets déposés. ATTENTION: étape abolie en février 2013, nouvelle forme non définie.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Préparation de la fiche synthèse des demandes de ressources&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Directeur, Coordonnateur, Décanat/Regroupement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Envoi numérisé de la fiche synthèse au Vice-rectorat Enseignement/Recherche dans les délais requis&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="360" height="101" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Tenue de la réunion du CODER&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Vice-recteur, Doyen/Doyenne, Vice-rectorat ER&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Le VRER préside; le doyen y assiste." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="360" height="71" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Tenue de la Régie du recteur&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Recteur, Rectorat&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Ni le doyen ni la coordonnatrice n&#x27;y assistent (sauf invitation)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="573" width="360" height="86" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Réception de l&#x27;Avis produit par le CODER (révisé par la Régie du recteur), impression et versement au dossier (après le CAD)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="699" width="360" height="116" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A09" name="A09 - Présentation des descriptifs de cours né"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A09 — Présentation des descriptifs de cours nécessitant un nouveau code à la Conférence des directeurs de département (CDD)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Activité mensuelle: attribuer l&#x27;appartenance départementale à chaque cours (nouveau/modifié) nécessitant un nouveau code de cours. Sous la responsabilité du VRER.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Préparation du tableau de codification des cours, accompagné des descriptifs de cours&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; File Maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="116" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Envoi du tableau de codification et des descriptifs numérisés au bureau du VRER (affaires départementales)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-9 (exemple)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="116" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Tenue de la CDD&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Vice-recteur, Vice-rectorat ER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="360" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Réception de la Résolution de la CDD approuvant la codification; dépôt en attendant l&#x27;informatisation sur SIGARE&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Mise à jour des codes de cours dans la banque de cours File maker s&#x27;il y a lieu&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; File maker&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat des études" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="743" width="360" height="86" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A10" name="A10 - Assignation des CLARDERS aux nouveaux co"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A10 — Assignation des CLARDERS aux nouveaux cours et aux cours modifiés&lt;/b&gt;&lt;br&gt;&lt;i&gt;Assignation du code CLARDER (classification ministérielle des champs disciplinaires) permettant la pondération lors de la déclaration étudiante (subvention ministérielle).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Préparation du tableau d&#x27;assignation CLARDER, accompagné des descriptifs de cours&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; File Maker / AEF_1_5_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-10 (exemple)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="101" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Analyse et assignation des CLARDER&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_5_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Table de classification MELS (2011); voir MP1-P1-11." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="360" height="101" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Envoi du tableau d&#x27;assignation CLARDER et descriptifs numérisés au registraire et au directeur des finances&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="360" height="101" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Validation des assignations et signature du tableau par les trois personnes; dépôt en attendant l&#x27;informatisation&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; AEF_1_5_2&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur + Registraire + Directeur des finances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="603" width="360" height="116" as="geometry"/></mxCell><mxCell id="c7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A11" name="A11 - Présentation du dossier au Conseil des é"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A11 — Présentation du dossier au Conseil des études UQ, à la CEP-CRÉPUQ et au CPU-MELS (instances externes)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Envoi au siège social (Réseau UQ), qui achemine à la CEP-CRÉPUQ (analyse-qualité) puis au CPU-MELS (analyse-opportunité, avis favorable au ministre, autorisation de financement). Un refus à toute étape met fin au processus. Après approbation (incl. résolution CAD), un code de programme et un CLARDER programme sont attribués par le siège social.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1260" height="110" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Inscription du dossier à l&#x27;ordre du jour du Conseil des études de l&#x27;UQ&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="360" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Envoi du dossier complet numérisé (résolutions Module, SCE, CET) au siège social (Réseau UQ)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Certains documents internes sont retirés avant envoi (commentaires, avis CODER, etc.)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="131" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Tenue du Conseil des études UQ&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Vice-recteur, Vice-rectorat ER&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Le VRER assiste, présente et défend le dossier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="507" width="360" height="71" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Extraction, impression et versement de la résolution du Conseil des études au dossier papier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; WEB UQ&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Commis sénior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Préparation d&#x27;un résumé du dossier de création à l&#x27;intention de la CEP-CRÉPUQ&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="759" width="360" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Envoi du résumé au siège social UQ&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="360" height="71" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — Préparation d&#x27;une liste d&#x27;experts à l&#x27;intention de la CEP&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Directeur, Regroupement de programmes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Envoi de la liste d&#x27;experts au siège social UQ&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1137" width="360" height="86" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — Envoi par le siège social UQ du dossier + résumé + liste d&#x27;experts à la CEP-CRÉPUQ (analyse-qualité)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Siège social UQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1263" width="360" height="86" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;T10&lt;/b&gt; — Tenue des réunions de la CEP (analyses préliminaire et approfondie)&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; CEP-CRÉPUQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1389" width="360" height="71" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;T11&lt;/b&gt; — Réception du complément d&#x27;information demandé par la CEP et demande d&#x27;entente sur la liste d&#x27;experts&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="360" height="101" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;T12&lt;/b&gt; — Production de la réponse au complément d&#x27;informatio