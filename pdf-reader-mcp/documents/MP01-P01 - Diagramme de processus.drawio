arget="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A12" name="A12 - Présentation du dossier au Conseil d&#x27;adm"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="780" pageHeight="1975" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&amp;#8592; Retour à la vue d&#x27;ensemble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1" link="data:page/id,page-overview"><mxGeometry x="40" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;A12 — Présentation du dossier au Conseil d&#x27;administration (CAD)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Instance légale ultime avant l&#x27;ouverture des admissions. Conditionnelle à l&#x27;approbation du Conseil des études UQ, de la CRÉPUQ et à l&#x27;autorisation de financement du MELS. Si le CAD précède ces approbations, la résolution du CAD est conditionnelle/sous réserve.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;T01&lt;/b&gt; — Inscription des points à l&#x27;ordre du jour du CAD auprès du Bureau du Secrétaire général&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="195" width="360" height="101" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;T02&lt;/b&gt; — Production de l&#x27;Avis d&#x27;inscription au CAD et synthèse du dossier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Coordonnateur, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="360" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;T03&lt;/b&gt; — Mise en pages de l&#x27;Avis d&#x27;inscription et synthèse sur le formulaire dédié&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="360" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;T04&lt;/b&gt; — Envoi de l&#x27;Avis d&#x27;inscription et synthèse au Bureau du VRER pour révision et validation&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="360" height="101" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;T05&lt;/b&gt; — Révision et validation de l&#x27;Avis d&#x27;inscription et synthèse par le Bureau du VRER&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Word&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Vice-recteur, Secrétaire de direction, Vice-rectorat ER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="729" width="360" height="101" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;T06&lt;/b&gt; — Envoi numérisé de l&#x27;Avis d&#x27;inscription, 10 jours ouvrables avant le CAD&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Vice-rectorat ER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="360" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;T07&lt;/b&gt; — S&#x27;il y a lieu, envoi de nouveau du dossier complet numérisé (sinon: dossier CET + résolution CET + Avis CODER)&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="996" width="360" height="101" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;T08&lt;/b&gt; — Tenue du CAD aux fins d&#x27;implantation du nouveau programme de grade&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Recteur, Rectorat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1137" width="360" height="71" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;T09&lt;/b&gt; — Extraction et impression de la résolution du CAD et versement au dossier papier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; WEB UQAC&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Commis sénior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1248" width="360" height="86" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;T10&lt;/b&gt; — Envoi numérisé au siège social UQ de la résolution du CAD, avec requête pour la délivrance d&#x27;un code de programme&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Secrétaire de direction, Décanat premier cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1374" width="360" height="101" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;T11&lt;/b&gt; — Réception de la fiche d&#x27;attribution du code de programme et du CLARDER programme, vérifications, impression et versement au dossier&lt;br&gt;&lt;i&gt;Application :&lt;/i&gt; Outlook&lt;br&gt;&lt;i&gt;Acteurs :&lt;/i&gt; Commis sénior, Coordonnateur, Doyen/Doyenne&lt;br&gt;&lt;i&gt;Note :&lt;/i&gt; Voir MP1-P1-12. Le CLARDER programme est assigné par le siège social." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1515" width="360" height="146" as="geometry"/></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-A13" name="A13 - Informatisation des cours, des CLARDERS "><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold=