# SQL Server Configuration Template
# Copy this to .env and fill in your values

# Connection Settings
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=master

# Authentication (SQL Auth)
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=

# Authentication Type: 'sql' or 'windows'
SQLSERVER_AUTH=sql

# Security
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=true

# Timeouts (milliseconds)
SQLSERVER_CONNECTION_TIMEOUT=30000
SQLSERVER_REQUEST_TIMEOUT=60000

# Query Limits
SQLSERVER_MAX_ROWS=1000
